<?xml version="1.0" encoding="utf-8"?>
<!-- Google Sans Flex (SIL OFL 1.1, assets/licenses/GoogleSansFlex-OFL.txt): one variable font file,
     exposed at the weights the UI uses. Hangul falls back to the system font. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/google_sans_flex" android:fontStyle="normal" android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/google_sans_flex" android:fontStyle="normal" android:fontWeight="500"
        android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/google_sans_flex" android:fontStyle="normal" android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
    <font android:font="@font/google_sans_flex" android:fontStyle="normal" android:fontWeight="700"
        android:fontVariationSettings="'wght' 700" />
</font-family>
